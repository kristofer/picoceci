"Composing objects"
object Counter {
    let count: Int.
    init  [ count := 0 ]
    inc   [ count := count + 1. ^self ]
    value [ ^count ]
}

object LoggedCounter {
    compose Counter.
    inc [ super inc. Console println: 'incremented'. ^self ]
}

let c: LoggedCounter.
c := LoggedCounter new.
c inc; inc; inc.
Console println: c value printString.   "=> 3"