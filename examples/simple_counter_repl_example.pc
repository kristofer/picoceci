"Simple Counter example for REPL"
"Paste this entire block into the REPL using paste mode (---)"

object Counter {
    let count: Int.
    init [ count := 0 ]
    inc [ count := count + 1. ^ self ]
    value [ ^ count ]
}

let c1: Counter. let c2: Counter.
c1 := Counter new.
c2 := Counter new.

c1 inc; inc; inc.
c2 inc; inc.

Console println: 'Counter 1: ', c1 value printString.
Console println: 'Counter 2: ', c2 value printString.
