"Two tasks, each with its own Counter, counting from 1 to 10"
"Complete version with Counter object declaration included"
"This version uses the actual Task API: spawn:name:"

"FIRST: Declare the Counter object"
object Counter {
    let count: Int.

    init [
        count := 0
    ]

    inc [
        count := count + 1.
        ^ self
    ]

    value [
        ^ count
    ]

    reset [
        count := 0.
        ^ self
    ]
}

"THEN: Use it to create instances"
let counter1: Counter. let counter2: Counter.

"Create two separate Counter instances"
counter1 := Counter new.
counter2 := Counter new.

"Task 1: Count from 1 to 10 with counter1"
"Note: Task spawn:name: is fire-and-forget (no handle returned)"
Task spawn: [
    [ counter1 value < 10 ] whileTrue: [
        counter1 inc.
        Console println: 'Task 1 - Counter: ', counter1 value printString
    ]
] name: 'counter-task-1'.

"Task 2: Count from 1 to 10 with counter2"
Task spawn: [
    [ counter2 value < 10 ] whileTrue: [
        counter2 inc.
        Console println: 'Task 2 - Counter: ', counter2 value printString
    ]
] name: 'counter-task-2'.

Console println: 'Both tasks started!'.
