"Two concurrent counters using TaskSupervisor"
"This version works with the current picoceci implementation"

object Counter {
    let count: Int.
    init [ count := 0 ]
    inc [ count := count + 1. ^ self ]
    value [ ^ count ]
}

let counter1: Counter. let counter2: Counter.
counter1 := Counter new.
counter2 := Counter new.

"Start first counter task"
TaskSupervisor supervise: [
    [ counter1 value < 10 ] whileTrue: [
        counter1 inc.
        Console println: 'Counter 1: ', counter1 value printString
    ]
] name: 'counter1'.

"Start second counter task"
TaskSupervisor supervise: [
    [ counter2 value < 10 ] whileTrue: [
        counter2 inc.
        Console println: 'Counter 2: ', counter2 value printString
    ]
] name: 'counter2'.

Console println: 'Both counters started!'.
Console println: 'Final - Counter 1: ', counter1 value printString.
Console println: 'Final - Counter 2: ', counter2 value printString.
